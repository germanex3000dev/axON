/* axON theme — all colors come from ~/.config/axon/config.toml
   (see config.py for the defaults). Do not hardcode colors here;
   reference the $ax-* variables instead. */

Screen {
    background: $ax-background;
    color: $ax-text;
}

Header {
    background: $ax-background;
    color: $ax-text;
    text-style: bold;
    height: 3;
    dock: top;
    border-bottom: solid $ax-dim;
}

Header:focus {
    background: $ax-background;
    border-bottom: solid $ax-accent;
}

Footer {
    background: $ax-background;
    color: $ax-text;
    height: 2;
    dock: bottom;
    border-top: solid $ax-dim;
}

Footer .key {
    color: $ax-text;
    text-style: bold;
}

Footer .key:focus {
    background: $ax-highlight;
    color: $ax-text;
}

#sidebar {
    width: $ax-sidebar-width;
    height: 1fr;
    border-right: solid $ax-dim;
    background: $ax-background;
}

#note-list {
    width: 100%;
    height: 1fr;
    margin: 1 1;
    border: solid $ax-dim;
    background: $ax-background;
}

#note-list:focus {
    border: solid $ax-accent;
}

#note-list > ListItem {
    background: $ax-background;
    color: $ax-text;
    padding: 0 1;
    border-bottom: solid $ax-gray;
}

#note-list > ListItem:hover {
    background: $ax-highlight;
    color: $ax-text;
}

#note-list > ListItem.--highlight {
    background: $ax-highlight;
    color: $ax-text;
    border-left: solid $ax-text;
}

#editor-panel {
    width: 1fr;
    height: 1fr;
}

#note-editor {
    width: 100%;
    height: 1fr;
    margin: 1 1;
    border: solid $ax-dim;
    background: $ax-background;
    color: $ax-text;
}

#note-editor:focus {
    border: solid $ax-accent;
}

#note-editor TextArea {
    background: $ax-background;
    color: $ax-text;
    border: none;
}

#note-editor TextArea:focus {
    background: $ax-background;
}

#note-title {
    height: 3;
    background: $ax-background;
    color: $ax-text;
    border-bottom: solid $ax-accent;
    padding: 0 2;
    content-align: left middle;
    text-style: bold;
}

#sidebar-title {
    width: 100%;
    height: 3;
    background: $ax-background;
    color: $ax-text;
    text-style: bold;
    content-align: center middle;
    border-bottom: solid $ax-dim;
}

#new-note-btn {
    width: 100%;
    height: 3;
    margin: 1 1;
    background: $ax-background;
    color: $ax-text;
    border: solid $ax-accent;
    text-style: bold;
}

#new-note-btn:hover {
    background: $ax-highlight;
    border: solid $ax-text;
}

#new-note-btn:focus {
    background: $ax-highlight;
    border: solid $ax-text;
}

#delete-note-btn {
    width: 100%;
    height: 3;
    margin: 0 1 1 1;
    background: $ax-background;
    color: $ax-text;
    border: solid $ax-dim;
    text-style: bold;
}

#delete-note-btn:hover {
    background: $ax-highlight;
    border: solid $ax-accent;
}

#delete-note-btn:focus {
    background: $ax-highlight;
    border: solid $ax-text;
}

#status-bar {
    height: 1;
    background: $ax-background;
    color: $ax-dim;
    padding: 0 2;
    content-align: left middle;
    border-top: solid $ax-gray;
}

Input {
    background: $ax-background;
    color: $ax-text;
    border: solid $ax-dim;
}

Input:focus {
    border: solid $ax-accent;
}

Label {
    color: $ax-text;
    padding: 0 1;
}

Static {
    color: $ax-text;
}

Scrollbar {
    background: $ax-background;
    color: $ax-dim;
}

Scrollbar:hover {
    color: $ax-accent;
}

Scrollbar:focus {
    color: $ax-text;
}